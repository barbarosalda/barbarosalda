# App
NODE_ENV=development
PORT=3000
# Comma-separated allowed CORS origins. Leave empty to allow all origins (dev only).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Messaging
# Options: node, rabbitmq. Defaults to "node" (in-process) when unset.
# Set to "rabbitmq" and provide RABBITMQ_URL to use a real broker.
MESSENGER=node
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Database
DATABASE_URL=postgresql://traderlock:traderlock@localhost:5432/traderlock_dev?schema=public
# Test database
# Use .env.test with DATABASE_URL in this project.
# DATABASE_URL_TEST=postgresql://traderlock:traderlock@localhost:5433/traderlock_test?schema=public

# Auth (single active provider)
AUTH_PROVIDER=dev
# Required only when AUTH_PROVIDER=cognito.
# COGNITO_REGION=eu-west-1
# COGNITO_USER_POOL_ID=eu-west-1_example
# COGNITO_CLIENT_ID=example-client-id
# Optional; can be derived from region + user pool.
# COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_example

# Logging
# LOGGER options: pino, console
LOG_LEVEL=info
LOG_PRETTY=true
LOGGER=pino