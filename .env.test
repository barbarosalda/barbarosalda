# -----------------------------------------------------------------------------
# App Environment Variables
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated allowed CORS origins. Leave empty to allow all origins (dev only).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com


# -----------------------------------------------------------------------------
# Messaging Environment Variables
# -----------------------------------------------------------------------------
# Options: node, rabbitmq. Defaults to "node" (in-process) when unset.
# Set to "rabbitmq" and provide RABBITMQ_URL to use a real broker.
MESSENGER=node
RABBITMQ_URL=amqp://guest:guest@localhost:5672


# -----------------------------------------------------------------------------
# Database Environment Variables
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://traderlock:traderlock@localhost:5433/traderlock_test?schema=public
# Test database
# Use .env.test with DATABASE_URL in this project.


# -----------------------------------------------------------------------------
# Auth Environment Variables
# -----------------------------------------------------------------------------
AUTH_PROVIDER=dev
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_qvHULGuaA
COGNITO_CLIENT_ID=ffbfnpr51dg4jj43fbon0dch1


# -----------------------------------------------------------------------------
# Logging Environment Variables
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
LOGGER=pino # LOGGER options: pino, console